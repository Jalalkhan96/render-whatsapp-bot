# Required. Keep this secret on the server; do not add it to public/index.html.
APIFY_API_TOKEN=your_apify_api_token
# Optional; defaults to clockworks~tiktok-profile-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks~tiktok-profile-scraper
# Keep local unless you intentionally configure a secured deployment.
HOST=127.0.0.1
PORT=4173
