# music-engine — environment configuration
# Copy to .env and fill in only the keys you have. Sources without keys
# report AUTH_REQUIRED honestly instead of pretending to work.

MUSIC_ENABLED=true

# ---- lyrics / licensed providers ----
GENIUS_API_KEY=
MUSIXMATCH_API_KEY=
LYRICFIND_API_KEY=

# ---- metadata ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_KEY=
LASTFM_API_KEY=
YOUTUBE_API_KEY=
DISCOGS_TOKEN=
SOUNDCLOUD_CLIENT_ID=

# ---- recognition ----
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_SECRET=
ACRCLOUD_HOST=
AUDD_API_TOKEN=

# ---- engine tuning ----
MUSIC_MAX_RESULTS=30
MUSIC_MAX_RETRIES=3
MUSIC_TIMEOUT=30000
MUSIC_CONCURRENT_SOURCES=1
MUSIC_CACHE_ENABLED=true

# ---- cache TTLs (seconds) ----
TRACK_CACHE_TTL=86400
LYRICS_CACHE_TTL=21600
CHART_CACHE_TTL=3600
TREND_CACHE_TTL=1800
ARTIST_CACHE_TTL=86400
ALBUM_CACHE_TTL=86400

# ---- optional: override adapter priorities (JSON: { "genius": 2 }) ----
MUSIC_PRIORITY_OVERRIDES={}

# ---- API server ----
PORT=3100
