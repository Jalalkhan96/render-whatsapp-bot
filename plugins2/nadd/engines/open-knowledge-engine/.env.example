# Open Knowledge Engine — environment configuration (§80)
# Copy to .env and fill in the keys you have. All keys are OPTIONAL unless
# noted; sources without keys degrade gracefully (auth_required status).

# Identification (required by Open Library / Nominatim politeness policies)
OPENKNOWLEDGE_CONTACT=

# --- API keys (only include credentials actually required by a source) ---
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
HARVARD_API_KEY=
RIJKSMUSEUM_KEY=
TROVE_KEY=
DIGITALNZ_KEY=
DPLA_KEY=
CONGRESS_KEY=
GOVINFO_KEY=
BHL_KEY=
CORE_KEY=
OPENALEX_KEY=
MAPILLARY_TOKEN=
OPENCORPORATES_TOKEN=
NOAA_TOKEN=
# data.gov Catalog API v4 (GSA) — required (catalog.data.gov CKAN is retired)
DATA_GOV_API_KEY=
# NARA Catalog API v2 — required (x-api-key header)
NARA_API_KEY=

# Email for Crossref polite pool (recommended)
CROSSREF_EMAIL=

# GeoNames (REQUIRED for geonames adapters — registered username)
GEONAMES_USERNAME=

# NASA (optional; DEMO_KEY works for low volume)
NASA_API_KEY=

# --- Engine tuning ---
KNOWLEDGE_REQUEST_TIMEOUT=20000
KNOWLEDGE_MAX_RETRIES=3
KNOWLEDGE_SOURCE_CONCURRENCY=1
KNOWLEDGE_CACHE_TTL=21600
MAX_RESULTS_PER_SOURCE=20
MAX_PAGES_PER_SOURCE=5
MAX_FINAL_RESULTS=50

# Wikidata SPARQL endpoint (configurable; 2026–2027 backend migration in progress)
WIKIDATA_SPARQL_ENDPOINT=

# Bulk ingestion master switch (admin only; default off)
KNOWLEDGE_BULK_ENABLED=0
