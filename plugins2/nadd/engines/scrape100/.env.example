# scrape100 environment example — copy to .env and fill secrets.
# NEVER commit real tokens. Secrets are read from env only.

# ---- limits (§16) ----
MAX_RESULTS_PER_SITE=50
MAX_PAGES_PER_SITE=5
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
MAX_RESPONSE_SIZE_MB=5
DEFAULT_REQUEST_DELAY_MS=1000

# ---- paths ----
DATA_DIR=./data
LOG_DIR=./logs
DB_FILE=./data/scrape100.db

# ---- logging ----
LOG_LEVEL=INFO

# ---- provider secrets (optional; only needed for provider transports) ----
APIFY_TOKEN=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
THREADS_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
PINTEREST_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
