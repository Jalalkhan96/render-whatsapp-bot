# --- Redis / Celery -------------------------------------------------
REDIS_URL=

# --- Storage ------------------------------------------------------------
DOWNLOAD_DIR=/data/downloads
COOKIES_DIR=
# local | s3
STORAGE_BACKEND=local
# Max bytes per finished file (2 GiB default)
MAX_FILE_SIZE=2147483648
# Finished files are deleted after this many seconds (1 hour default)
FILE_TTL_SECONDS=3600

# --- Jobs ---------------------------------------------------------------
# Hard cap per download job, in seconds (15 minutes default)
JOB_TIMEOUT=900

# --- Rate limiting ------------------------------------------------------
# Requests per minute per IP on /api/analyze and /api/download (0 = off)
RATE_LIMIT_PER_MINUTE=10

# --- Auth ---------------------------------------------------------------
# When set, /api/* (except /health) requires it via X-API-Key header
# or ?api_key= query param. Admin endpoints REQUIRE it to be set.
API_KEY=

# --- Proxy pool ---------------------------------------------------------
# Comma-separated proxy URLs, rotated per job attempt, e.g.:
# PROXY_LIST=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXY_LIST=

# --- S3 / Cloudflare R2 (only used when STORAGE_BACKEND=s3) --------------
S3_ENDPOINT_URL=
S3_BUCKET=video-downloader
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PREFIX=downloads/

# --- Public API access --------------------------------------------------
# Public URL the API is reachable at, e.g. your domain or the tunnel URL.
# Reported by GET /api/info and logged on startup. Leave empty for LAN-only use.
PUBLIC_BASE_URL=
# Comma-separated CORS origins, or "*" (default) to allow API calls from anywhere.
CORS_ORIGINS=*

# --- Self-ping (keep-alive) ------------------------------------------------
# The API pings its own /ping every N seconds so free hosts (Render, etc.)
# never sleep from inactivity. Target: PUBLIC_BASE_URL, else RENDER_EXTERNAL_URL
# (set automatically by Render), else http://127.0.0.1:$PORT.
SELF_PING_ENABLED=true
SELF_PING_INTERVAL_SECONDS=300

# --- yt-dlp -------------------------------------------------------------
YTDLP_UPDATE_ON_START=true
# Path to deno binary (resolves via PATH when just "deno")
DENO_PATH=deno

LOG_LEVEL=INFO
