# ____REMOVE THIS LINE AFTER RENAMING sample.env to .env ____

# PUT YOUR SESSION ID BELOW
SESSION_ID=

# PUT YOUR REMOVE BACKGROUND API KEY BELOW
REMOVEBG_KEY=

PORT=5000

# If you don't have session id and want pairing code for connection 
PAIRING_NUMBER=

# Google Apps Script Web App URL for .babar, .king and .kingvideo
CRICKET_DRIVE_API_URL=
CRICKET_BABAR_API_URL=
CRICKET_AMIR_API_URL=
CRICKET_VIDEO_API_URL=

# ABIX-AE WhatsApp channel metadata
NEWSLETTER_JID=
NEWSLETTER_NAME=

# Free Fire community API providers.
# Use a provider URL you have tested. Templates {uid}, {region}, {keyword},
# {server} and {key} are replaced automatically.
FF_INFO_API=
FF_INFO_API_2=
FF_BAN_API=
FF_SEARCH_API=
FF_API_KEY=
FF_API_TIMEOUT_MS=8000
FF_LOCAL_API=true
FF_LOCAL_API_URL=
FF_PROXY_KEY=
# Optional upstream providers used by the local ABIX-AE proxy:
FF_UPSTREAM_INFO_API=
FF_UPSTREAM_BAN_API=
FF_UPSTREAM_SEARCH_API=
# Example formats:
# FF_INFO_API=https://provider.example/info?uid={uid}&region={region}
# FF_INFO_API_2=https://provider.example/account/{region}/{uid}
# FF_BAN_API=https://provider.example/ban?uid={uid}&key={key}
# FF_SEARCH_API=https://provider.example/search?keyword={keyword}&server={server}


# Use One Of Following:
# Database Configuration (Optional but recommended)
# Leave empty to use JSON file storage

# MongoDB
MONGO_URL=

# PostgreSQL
POSTGRES_URL=

# MySQL
MYSQL_URL=

# SQLite (provide path only if you want to use SQLite)
# Example: DB_URL=./data/baileys.db
DB_URL=

PREFIXES=.,!,/

PACKNAME=ABIX

BOT_NAME=ABIX

OWNER_NUMBER=

COMMAND_MODE=private

MAX_STORE_MESSAGES=50

BOT_OWNER=

TIMEZONE=Asia/Karachi
