# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set this value in Render Dashboard > your service > Environment.
API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=8000
DOWNLOAD_DIR=/tmp/video-audio-downloader
MAX_DOWNLOAD_MB=150
MAX_DURATION_SECONDS=3600
MAX_ACTIVE_JOBS=1
FILE_TTL_MINUTES=10
SOCKET_TIMEOUT_SECONDS=15
CORS_ORIGINS=*
