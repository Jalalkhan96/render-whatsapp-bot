# ABIX-AE / Render configuration template. Never commit a real .env file.
# Required to pair WhatsApp when no saved session exists (digits only, country code included).
OWNER_NUMBER=923001234567
# Optional: additional trusted owner numbers, comma-separated.
SECONDARY_OWNER_NUMBERS=
BOT_NAME=ABIX-AE
BOT_PREFIX=-
TIMEZONE=Asia/Karachi

# Use the official Gemini API in production; add your key in Render Environment.
GEMINI_BACKEND=official
GEMINI_USE_WEB2API=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Platform-provided PORT is used automatically by Render.
HOST=0.0.0.0
FFMPEG_PATH=/usr/bin/ffmpeg
SESSION_DIR=/var/data/session
BOT_MEMORY_WARN_MB=1200
NODE_OPTIONS=--max-old-space-size=1280

# Optional integrations: add only the keys you use, via Render's Environment page.
APIFY_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=
MONGO_URL=
POSTGRES_URL=
MYSQL_URL=
